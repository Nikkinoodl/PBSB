layout: base.njk
title: "Contact"
permalink: /home/contact/
---

<div class="container py-5">
  <h2>Contact Us</h2>

  <form id="contactForm" class="mt-4">
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input type="text" class="form-control" name="name" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" class="form-control" name="email" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Message</label>
      <textarea class="form-control" name="message" rows="4" required></textarea>
    </div>

    <input type="text" id="website" name="website" style="display:none">

    <button class="btn btn-primary" type="submit">Send Message</button>
  </form>

  <div id="status" class="mt-3"></div>
</div>

<script>
// --- Anti-bot timing check ---
let formOpenedAt = Date.now();

document.getElementById("contactForm").addEventListener("submit", async (e) => {
  e.preventDefault();

  const form = e.target;
  const status = document.getElementById("status");

  const data = {
    name: form.name.value.trim(),
    email: form.email.value.trim(),
    message: form.message.value.trim()
  };

  // --- Honeypot field ---
  if (document.querySelector("#website").value !== "") {
    return; // silently drop bot submission
  }

  // --- Timing check (bots submit instantly) ---
  if (Date.now() - formOpenedAt < 1500) {
    status.innerHTML = `<div class="alert alert-danger">Please take a moment before submitting.</div>`;
    return;
  }

  // --- Basic field validation ---
  if (!data.name || data.name.length < 2 || data.name.length > 200) {
    status.innerHTML = `<div class="alert alert-danger">Please enter a valid name.</div>`;
    return;
  }

  // --- Email validation ---
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailRegex.test(data.email) || data.email.length > 300) {
    status.innerHTML = `<div class="alert alert-danger">Please enter a valid email address.</div>`;
    return;
  }

  // --- Message length validation ---
  if (data.message.length < 10 || data.message.length > 5000) {
    status.innerHTML = `<div class="alert alert-danger">Message must be between 10 and 5000 characters.</div>`;
    return;
  }

  // --- Hyperlink detection (your existing rule) ---
  const linkRegex = /(https?:\/\/\S+)|www\.\S+|\S+\.\S{2,}/i;
  if (linkRegex.test(data.message)) {
    status.innerHTML = `<div class="alert alert-danger">Links are not allowed in the message.</div>`;
    return;
  }

  // --- Strip HTML tags ---
  data.message = data.message.replace(/<[^>]*>/g, "");

  // --- Printable character enforcement ---
  const printable = /^[\x20-\x7E\r\n]+$/;
  if (!printable.test(data.message)) {
    status.innerHTML = `<div class="alert alert-danger">Message contains invalid characters.</div>`;
    return;
  }

  // --- Payload size limit ---
  if (JSON.stringify(data).length > 10000) {
    status.innerHTML = `<div class="alert alert-danger">Message is too large.</div>`;
    return;
  }

  try {
    const response = await fetch("https://xihm27qckj.execute-api.us-east-1.amazonaws.com/home/contact", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data)
    });

    if (response.ok) {
      status.innerHTML = `<div class="alert alert-success">Message sent!</div>`;
      form.reset();
      formOpenedAt = Date.now(); // reset timer
    } else {
      status.innerHTML = `<div class="alert alert-danger">Something went wrong.</div>`;
    }
  } catch (err) {
    status.innerHTML = `<div class="alert alert-danger">Network error.</div>`;
  }
});
</script>



